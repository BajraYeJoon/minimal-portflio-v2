{
  "name": "binaya-bajracharya-enhanced-portfolio-website",
  "private": true,
  "version": "2.0.0-development",
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "postinstall": "husky",
    "lint": "biome check .",
    "format": "biome format . --write",
    "test": "echo \"Error: no test specified\" && exit 1",
    "format:check": "biome format . --write",
    "lint:fix": "biome check --write .",
    "validate": "bun run typecheck && bun run lint && bun run format:check",
    "release": "semantic-release"
  },
  "dependencies": {
    "@netlify/vite-plugin-react-router": "^1.0.1",
    "@number-flow/react": "^0.5.10",
    "@react-router/node": "^7.9.6",
    "@react-router/serve": "^7.9.6",
    "@sanity/client": "^6.29.1",
    "@sanity/image-url": "^1.2.0",
    "isbot": "^5.1.32",
    "lenis": "^1.3.15",
    "motion": "^12.23.24",
    "posthog-js": "^1.297.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0",
    "react-router": "^7.9.6",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@commitlint/config-conventional": "^19.8.1",
    "@react-router/dev": "^7.9.6",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.6",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^20.19.25",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "commitlint": "^19.8.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "react-router-devtools": "^1.1.10",
    "semantic-release": "^24.2.9",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "biome check --write",
      "biome format --write"
    ]
  },
  "release": {
    "branches": [
      "master"
    ]
  }
}