{
  "name": "binaya-bajracharya-enhanced-portfolio-website",
  "private": true,
  "version": "2.0.0-development",
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "postinstall": "husky",
    "lint": "biome check .",
    "format": "biome format . --write",
    "test": "echo \"Error: no test specified\" && exit 1",
    "format:check": "biome format .",
    "lint:fix": "biome check --write .",
    "validate": "bun run typecheck && bun run lint && bun run format:check",
    "seed:sanity": "bun scripts/seed-sanity.ts",
    "release": "semantic-release"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@netlify/vite-plugin-react-router": "^4.0.0",
    "@number-flow/react": "^0.6.2",
    "@react-router/node": "^8.5.2",
    "@react-router/serve": "^8.5.2",
    "@sanity/client": "^8.17.0",
    "@sanity/image-url": "^2.2.0",
    "gsap": "^3.15.1",
    "isbot": "^5.2.3",
    "lenis": "^1.3.27",
    "motion": "^14.14.0",
    "posthog-js": "^1.453.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-router": "^8.5.2",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@commitlint/config-conventional": "^21.2.4",
    "@react-router/dev": "^8.5.2",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.11",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "commitlint": "^21.2.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "react-router-devtools": "^6.2.3",
    "semantic-release": "^26.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "biome check --write",
      "biome format --write"
    ]
  },
  "release": {
    "branches": [
      "master"
    ]
  }
}
